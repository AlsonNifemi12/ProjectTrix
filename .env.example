NODE_ENV=development
PORT=4000
DATABASE_URL=postgresql://postgres:postgres@localhost:5432/projecttrix

# Use a random value with at least 32 characters in deployed environments.
JWT_SECRET=replace-with-a-long-random-secret
SESSION_COOKIE_NAME=projecttrix_session
COOKIE_SAME_SITE=lax

FRONTEND_URL=http://localhost:5173
API_URL=http://localhost:4000
CORS_ORIGINS=http://localhost:5173

GITLAB_BASE_URL=https://gitlab.com
GITLAB_CLIENT_ID=
GITLAB_CLIENT_SECRET=
GITLAB_CALLBACK_URL=http://localhost:4000/api/v1/auth/gitlab/callback
