{
  "name": "projecttrix-api",
  "version": "0.1.0",
  "private": true,
  "description": "Backend API for ProjectTrix",
  "type": "module",
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "dev": "npm run build && node --watch dist/src/server.js",
    "build": "tsc -p tsconfig.json",
    "start": "node dist/src/server.js",
    "start:render": "node dist/src/scripts/migrate.js && node dist/src/server.js",
    "typecheck": "tsc --noEmit",
    "test": "npm run build && node --test --test-isolation=none dist/tests/app.test.js dist/tests/validation.test.js",
    "db:migrate": "npm run build && node dist/src/scripts/migrate.js",
    "db:seed": "npm run build && node dist/src/scripts/seed.js"
  },
  "dependencies": {
    "cookie-parser": "^1.4.7",
    "cors": "^2.8.6",
    "dotenv": "^18.0.5",
    "express": "^5.2.1",
    "express-rate-limit": "^8.7.0",
    "helmet": "^8.3.0",
    "jsonwebtoken": "^9.0.3",
    "pg": "^8.23.1",
    "swagger-ui-express": "^5.0.1",
    "yaml": "^2.9.1",
    "zod": "^4.6.5"
  },
  "devDependencies": {
    "@types/cookie-parser": "^1.4.10",
    "@types/cors": "^2.8.19",
    "@types/express": "^5.0.6",
    "@types/jsonwebtoken": "^9.0.10",
    "@types/node": "^26.6.3",
    "@types/pg": "^8.23.1",
    "@types/supertest": "^7.2.1",
    "@types/swagger-ui-express": "^4.1.8",
    "supertest": "^7.3.0",
    "typescript": "^7.0.2"
  }
}
